# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps API Key (Required for Delivery Zone Feature)
# Get your key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Geocoding API, Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Optional: Analytics and Tracking
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# NEXT_PUBLIC_FB_PIXEL_ID=your-facebook-pixel-id

# Optional: API Keys (if needed for future features)
# API_KEY=your-api-key-here
# DATABASE_URL=your-database-connection-string

# Optional: Third-party Services
# EMAIL_SERVICE_API_KEY=your-email-service-key
# SMS_SERVICE_API_KEY=your-sms-service-key

# Development/Production Environment
NODE_ENV=development
